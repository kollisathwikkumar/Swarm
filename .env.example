# ReviewBoard Environment Configuration
# Copy to .env and fill in your DeepSeek API keys and GitHub credentials.

# --- Application & Security ---
APP_ENV=development
SECRET_KEY=change-this-to-a-random-64-char-secret
ENCRYPTION_KEY=
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
WORKSPACE_DIR=./.reviewboard_workspaces

# --- Database & Queue ---
# Lightweight local default (zero Docker required):
DATABASE_URL=sqlite+aiosqlite:///./reviewboard.db
# Production PostgreSQL alternative:
# DATABASE_URL=postgresql+asyncpg://reviewboard:reviewboard@localhost:5432/reviewboard

# Optional Redis + Celery (set CELERY_ENABLED=true when running Redis/Celery worker)
CELERY_ENABLED=false
REDIS_URL=redis://localhost:6379/0

# --- DeepSeek LLM Configuration (OpenAI-compatible) ---
# You can supply one shared DEEPSEEK_API_KEY and/or separate per-agent API keys!
# You can also manage/override these live inside the ReviewBoard Settings UI.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=

# Recommended per-agent defaults: V4 Flash for parallel extraction/checks, V4 Pro for deep security & synthesis
DIFF_AGENT_MODEL=deepseek-flash
DIFF_AGENT_BASE_URL=
DIFF_AGENT_API_KEY=

STYLE_AGENT_MODEL=deepseek-flash
STYLE_AGENT_BASE_URL=
STYLE_AGENT_API_KEY=

SECURITY_AGENT_MODEL=deepseek-v4-pro
SECURITY_AGENT_BASE_URL=
SECURITY_AGENT_API_KEY=

TEST_COVERAGE_AGENT_MODEL=deepseek-flash
TEST_COVERAGE_AGENT_BASE_URL=
TEST_COVERAGE_AGENT_API_KEY=

REVIEWER_MANAGER_MODEL=deepseek-v4-pro
REVIEWER_MANAGER_BASE_URL=
REVIEWER_MANAGER_API_KEY=

FIX_SUGGESTION_AGENT_MODEL=deepseek-v4-pro
FIX_SUGGESTION_AGENT_BASE_URL=
FIX_SUGGESTION_AGENT_API_KEY=

# --- GitHub Integration ---
# Optional default Personal Access Token (can also be connected per-account in Repositories/Settings UI)
GITHUB_TOKEN=
# Optional GitHub OAuth App credentials
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:3000/settings?github_oauth=callback
# Webhook secret for verifying X-Hub-Signature-256 on /api/github/webhook
GITHUB_WEBHOOK_SECRET=

# --- Local Review Companion ---
LOCAL_COMPANION_URL=http://127.0.0.1:8765
